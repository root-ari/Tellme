{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        "friends": {
          "$friendUid": {
            ".write": "auth != null && (auth.uid == $uid || auth.uid == $friendUid)"
          }
        },
        "friendRequests": {
          "$senderUid": {
            ".write": "auth != null && (auth.uid == $uid || auth.uid == $senderUid)"
          }
        },
        "sentRequests": {
          "$receiverUid": {
            ".write": "auth != null && (auth.uid == $uid || auth.uid == $receiverUid)"
          }
        }
      }
    },
    "usernames": {
      "$username": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('uid').val() == auth.uid || (newData.exists() && newData.child('uid').val() == auth.uid))"
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && $chatId.contains(auth.uid)",
        ".write": "auth != null && $chatId.contains(auth.uid)",
        "messages": {
          ".indexOn": ["timestamp"],
          "$messageId": {
            ".read": "auth != null && $chatId.contains(auth.uid)",
            ".write": "auth != null && $chatId.contains(auth.uid) && (!data.exists() || data.child('senderUid').val() == auth.uid) && newData.child('senderUid').val() == auth.uid"
          }
        }
      }
    }
  }
}
